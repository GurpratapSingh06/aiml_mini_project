# =========================================================
# VEDANTA — Environment Configuration Template
# MITAOE Knowledge Intelligence Platform
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =========================================================

# ---- Application ----------------------------------------
APP_NAME=VEDANTA
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-256-bit-hex-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_VERSION=0.1.0

# ---- Database (PostgreSQL) ------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vedanta
POSTGRES_USER=vedanta
POSTGRES_PASSWORD=vedanta_dev_password
DATABASE_URL=postgresql+asyncpg://vedanta:vedanta_dev_password@localhost:5432/vedanta
DATABASE_SYNC_URL=postgresql://vedanta:vedanta_dev_password@localhost:5432/vedanta
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- Redis ----------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---- Cache ----------------------------------------------
CACHE_DEFAULT_TTL=3600
CACHE_QUERY_TTL=1800
CACHE_EMBEDDING_TTL=86400

# ---- Worker (RQ) ----------------------------------------
WORKER_QUEUES=crawl,document,embedding,default
WORKER_CONCURRENCY=2

# ---- Crawling -------------------------------------------
CRAWL_ALLOWED_DOMAINS=mitaoe.ac.in,www.mitaoe.ac.in
CRAWL_START_URL=https://mitaoe.ac.in
CRAWL_MAX_DEPTH=5
CRAWL_MAX_PAGES=5000
CRAWL_CONCURRENCY=5
CRAWL_DELAY_SECONDS=1.0
CRAWL_REQUEST_TIMEOUT=30
CRAWL_MAX_RETRIES=3
CRAWL_USER_AGENT=VEDANTA-Crawler/0.1 (MITAOE Knowledge Platform; +https://mitaoe.ac.in)
CRAWL_RESPECT_ROBOTS=true

# ---- Document Processing --------------------------------
DOCUMENT_STORAGE_PATH=./data/documents
DOCUMENT_MAX_SIZE_MB=50
DOCUMENT_OCR_ENGINE=tesseract
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_TESSERACT_CMD=tesseract
DOCUMENT_PADDLE_OCR=false

# ---- AI / Embeddings ------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- FAISS ----------------------------------------------
FAISS_INDEX_PATH=./data/indexes
FAISS_INDEX_TYPE=flat_ip
FAISS_NPROBE=10

# ---- Retrieval ------------------------------------------
RETRIEVAL_TOP_K=20
RETRIEVAL_RERANK_TOP_K=5
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
BM25_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6

# ---- Security -------------------------------------------
API_KEY_ADMIN=change-this-admin-api-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ---- Frontend -------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=VEDANTA
NEXT_PUBLIC_APP_TAGLINE=Discover Knowledge. Trust Every Answer.
