# VEDANTA — Git Ignore

# ---- Python -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
dist/
build/
eggs/
.eggs/
*.egg
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
*.pyo
*.pyd
*.pyc

# ---- Node.js ------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.npm

# ---- Next.js ------------------------------------------------
frontend/.next/
frontend/out/
frontend/build/

# ---- Environment --------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ---- Data and Models ----------------------------------------
data/raw/*
data/processed/*
data/documents/*
data/indexes/*
data/embeddings/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/documents/.gitkeep
!data/indexes/.gitkeep
!data/embeddings/.gitkeep

# ---- Logs ---------------------------------------------------
logs/
*.log

# ---- Databases ----------------------------------------------
*.db
*.sqlite
*.sqlite3

# ---- Docker -------------------------------------------------
.dockerignore

# ---- IDE ----------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Alembic ------------------------------------------------
backend/alembic/versions/*.pyc

# ---- Model Cache --------------------------------------------
backend/.model_cache/
~/.cache/huggingface/
~/.cache/torch/

# ---- Testing ------------------------------------------------
.pytest_cache/
test-results/
coverage.xml
